# Runpod API key, used by launch_pod.py (Runpod console -> Settings -> API Keys).
RUNPOD_API_KEY=

# Hugging Face token. Optional for this Apache-2.0 model; required only for gated models.
HF_TOKEN=

# Set to require Bearer-token auth on the server. Leave blank to disable auth.
API_KEY=

# Serving config (defaults shown; override only if needed).
MODEL_PATH=WhiteRabbitNeo/WhiteRabbitNeo-V3-7B
SERVED_MODEL_NAME=whiterabbitneo-v3
PORT=30000
CONTEXT_LENGTH=32768
MEM_FRACTION_STATIC=0.9
TP_SIZE=1
